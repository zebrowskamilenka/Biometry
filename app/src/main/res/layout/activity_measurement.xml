<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Wróć"
            android:textSize="16sp"
            android:textColor="@color/primary"
            android:padding="8dp"/>

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Raport EKG"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wybierz raport EKG z Huawei Health."
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Karta podglądu PDF -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="14dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Podgląd raportu EKG"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="12dp"/>

            <ImageView
                android:id="@+id/imgPdfPreview"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="Podgląd raportu EKG"/>

            <TextView
                android:id="@+id/txtPreviewPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:text="PDF\n\nWybierz raport, aby zobaczyć wykres EKG"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:gravity="center"/>

        </LinearLayout>

        <!-- Wybieranie PDF -->
        <Button
            android:id="@+id/btnSelectPdf"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Wybierz plik PDF"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"/>

        <TextView
            android:id="@+id/txtFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nie wybrano pliku"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="12dp"/>

        <!-- Karta analizy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analiza biometryczna"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="12dp"/>

            <ProgressBar
                android:id="@+id/analysisProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary"
                android:visibility="gone"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/txtAnalysisStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Oczekiwanie na raport PDF"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
